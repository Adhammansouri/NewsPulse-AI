PassengerAppRoot /home/u358087675/domains/darkred-sparrow-645513.hostingersite.com/hbuilds/current/nodejs
PassengerAppType node
PassengerNodejs /opt/alt/alt-nodejs20/root/bin/node
PassengerStartupFile server.cjs
PassengerBaseURI /
PassengerRestartDir /home/u358087675/domains/darkred-sparrow-645513.hostingersite.com/hbuilds/current/nodejs/tmp
SetEnv NODE_OPTIONS "--require /home/u358087675/domains/darkred-sparrow-645513.hostingersite.com/hbuilds/config/preload-timestamp.js"
SetEnv LSNODE_CONSOLE_LOG console.log

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /
  RewriteRule ^index\.html$ - [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_URI} !^/api
  RewriteRule . /index.html [L]
</IfModule>

AddType application/manifest+json .webmanifest

<IfModule mod_headers.c>
  <FilesMatch "^(sw\.js|workbox-.*\.js)$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
  </FilesMatch>
</IfModule>
