# Server
PORT=3001
HOST=0.0.0.0
CORS_ORIGIN=http://localhost:5173
JWT_SECRET=change-me-in-production

# OpenAI — default flagship model for all AI tools (override per task if needed)
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-5.6-sol
# OPENAI_MODEL_GENERATE=gpt-5.6-sol
# OPENAI_MODEL_SUMMARIZE=gpt-5.6-sol
# OPENAI_MODEL_TRANSLATE=gpt-5.6-sol

# Dev seed user (in-memory until a database is wired)
AUTH_SEED_IDENTIFIER=adham
AUTH_SEED_PASSWORD=123456
AUTH_SEED_EMAIL=adham@newsplus.local
AUTH_SEED_PHONE=01000000000
AUTH_SEED_DISPLAY_NAME=Adham

# Web Push (generate with: npx web-push generate-vapid-keys)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:newsplus@localhost
# Optional. Default: ./data/push-subscriptions.json (or Hostinger hbuilds/config)
# PUSH_STORE_PATH=