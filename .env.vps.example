# Copy to .env on the VPS: cp .env.vps.example .env
# Domain must match Caddyfile and DNS A record → VPS IP (148.230.124.124)

NODE_ENV=production
HOST=0.0.0.0
PORT=3001
CORS_ORIGIN=https://srv1930800.hstgr.cloud

# Generate: openssl rand -hex 32
JWT_SECRET=change-me-generate-with-openssl-rand-hex-32

# Optional — required for AI features
OPENAI_API_KEY=

# Production seed user (change password after first login)
AUTH_SEED_IDENTIFIER=adham
AUTH_SEED_PASSWORD=change-me-after-deploy
AUTH_SEED_EMAIL=adham@xpayops.online
AUTH_SEED_PHONE=01000000000
AUTH_SEED_DISPLAY_NAME=Adham

# Web Push — generate: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:adham@xpayops.online
PUSH_STORE_PATH=/data/push-subscriptions.json
